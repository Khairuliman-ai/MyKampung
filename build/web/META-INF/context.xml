<?xml version="1.0" encoding="UTF-8"?>
<Context path="/MyKampung">
    <Resource name="jdbc/mykampung"
              auth="Container"
              type="javax.sql.DataSource"
              factory="org.apache.tomcat.jdbc.pool.DataSourceFactory"
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://localhost:3306/mykampung_v2_db?useSSL=false&amp;allowPublicKeyRetrieval=true"
              username="root"
              password=""
              maxActive="20"
              maxIdle="10"
              minIdle="5"
              maxWait="10000"
              validationQuery="SELECT 1"
              testOnBorrow="true"
              closeMethod="close"/>
</Context>
