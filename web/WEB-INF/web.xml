<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/views/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>BantuanServlet</servlet-name>
        <servlet-class>controller.BantuanServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BantuanServlet</servlet-name>
        <url-pattern>/bantuan/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FasilitiServlet</servlet-name>
        <servlet-class>controller.FasilitiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FasilitiServlet</servlet-name>
        <url-pattern>/fasiliti/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AduanServlet</servlet-name>
        <servlet-class>controller.AduanServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AduanServlet</servlet-name>
        <url-pattern>/aduan/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HebahanServlet</servlet-name>
        <servlet-class>controller.HebahanServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HebahanServlet</servlet-name>
        <url-pattern>/hebahan/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ChatbotServlet</servlet-name>
        <servlet-class>controller.ChatbotServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChatbotServlet</servlet-name>
        <url-pattern>/chatbot/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LaporanServlet</servlet-name>
        <servlet-class>controller.LaporanServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LaporanServlet</servlet-name>
        <url-pattern>/laporan/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>NotificationServlet</servlet-name>
        <servlet-class>controller.NotificationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotificationServlet</servlet-name>
        <url-pattern>/notifikasi/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <resource-ref>
        <description>MySQL Connection Pool for MyKampung</description>
        <res-ref-name>jdbc/mykampung</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>
</web-app>
